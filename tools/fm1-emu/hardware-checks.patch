+pub static TRAP_ARMED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub static TRAPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cold]
+pub fn trap_note(pc: u32, what: &str) {
+    if !TRAP_ARMED.load(std::sync::atomic::Ordering::Relaxed) { return; }
+    let n = TRAPS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    if n < 5 { println!("TRAP: {what} divide by zero at pc {pc:#010x} with EMU_CON bit 2 set (a CPU exception on an FM-1)"); }
+}
